{
  "name": "clipsync",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "prebuild": "node scripts/check-public-env.mjs && npm run build:extension && npm run build:signaling",
    "build:extension": "node scripts/build-extension.mjs",
    "build:signaling": "node scripts/build-signaling.mjs",
    "start:signaling": "node server/dist/index.cjs",
    "dev:signaling": "tsx --env-file-if-exists=.env.signaling server/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:env": "node scripts/setup-env.mjs",
    "verify:backend": "tsx --env-file=.env.local scripts/verify-backend.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "2.118.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.65.0",
    "ws": "8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/chrome": "0.3.5",
    "@types/node": "^22.18.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.4.2",
    "fflate": "0.8.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
